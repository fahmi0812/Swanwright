{
  "name": "swanwright",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "description": "Swanwright \u2014 lapisan OpenCode non-invasif: orchestrator tipis, 6 sektor, done-gate berbukti, skill lazy.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
